# Base partagée (Supabase). Sans ces deux valeurs, l'application fonctionne
# normalement mais chaque navigateur garde ses propres données.
#
# Elles se trouvent dans Supabase → Project Settings → API.
# La clé « anon » est publiable : elle est destinée au navigateur.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
