# Base PostgreSQL. En local : l'URL affichée par `npm run db:local`.
DATABASE_URL=postgresql://cresus:cresus@127.0.0.1:5544/cresus

# Secret de signature des jetons. Obligatoire en production : une longue
# chaîne aléatoire (par exemple `openssl rand -hex 32`).
JWT_SECRET=

# Connexion sans mot de passe aux comptes de démonstration (comportement du
# prototype). À laisser à false pour une instance réelle.
DEMO_LOGIN=true

# Origines autorisées (séparées par des virgules).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://ncheikha-bot.github.io

# Port local de l'API. L'hébergeur fournit le sien en production.
PORT=4001
