{
  "rootDir": "..",
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json",
        "diagnostics": {
          "ignoreCodes": [
            151002
          ]
        }
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
